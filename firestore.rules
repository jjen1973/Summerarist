rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Summarist: each account owns its saved and finished book IDs.
    match /users/{userId}/library/shelf {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['saved', 'finished'])
        && (!('saved' in request.resource.data) || request.resource.data.saved is list)
        && (!('finished' in request.resource.data) || request.resource.data.finished is list);
    }

    // Subscription records are written only by the payment backend.
    match /customers/{userId}/subscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /titles/{titleId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/myList/{titleId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}